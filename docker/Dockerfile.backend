FROM maven:3.8-openjdk-17 AS builder
WORKDIR /build
COPY initialization-note-side/pom.xml .
COPY initialization-note-side/src ./src
RUN mvn clean package -DskipTests

FROM openjdk:17-jdk
WORKDIR /app
RUN mkdir -p /app/uploads /app/config
COPY --from=builder /build/target/*.jar app.jar
COPY initialization-note-side/sql/complete_database_init.sql /app/sql/
ENV TZ=Asia/Shanghai
EXPOSE 8889
ENTRYPOINT ["java", "-jar", "app.jar"]